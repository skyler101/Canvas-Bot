# --- Required: Canvas (use ONE option; see README) ---
# Your school's Canvas URL (needed for Options A and C)
CANVAS_BASE_URL=https://yourschool.instructure.com

# Option A: browser login. Just run `python morning_brief.py --login`.
# (Optional) where to keep the saved login; default ~/.canvas-bot/session.json
# CANVAS_SESSION_FILE=

# Option B: Canvas -> Calendar -> "Calendar Feed" link. Also a good backup for A.
CANVAS_ICS_URL=

# Option C: API token, if your school allows it
# Canvas -> Account -> Settings -> "+ New Access Token"
CANVAS_TOKEN=

# Your local timezone (IANA name)
TIMEZONE=America/Denver
# How many days ahead to look
DAYS_AHEAD=7

# --- Optional: AI study plan ---
# Easiest: install Claude Code and log in (uses your Claude subscription), leave this blank.
# Or set an API key from console.anthropic.com (billed separately):
ANTHROPIC_API_KEY=

# --- Optional: delivery (any combination; brief is always printed) ---
# Email via SMTP (Gmail: use an App Password, smtp.gmail.com:587)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_TO=
# Discord channel webhook URL
DISCORD_WEBHOOK_URL=
# Push notification to your phone via https://ntfy.sh (pick a long random topic name)
NTFY_TOPIC=
