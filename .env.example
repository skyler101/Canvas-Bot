# --- Required: Canvas ---
# Your school's Canvas URL (no trailing slash), e.g. https://canvas.instructure.com or https://myschool.instructure.com
CANVAS_BASE_URL=https://yourschool.instructure.com
# Canvas -> Account -> Settings -> "+ New Access Token"
CANVAS_TOKEN=

# Your local timezone (IANA name)
TIMEZONE=America/New_York
# How many days ahead to look
DAYS_AHEAD=7

# --- Optional: AI study plan (skip to get a plain list) ---
ANTHROPIC_API_KEY=

# --- Optional: delivery (any combination; brief is always printed) ---
# Email via SMTP (Gmail: use an App Password, smtp.gmail.com:587)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_TO=
# Discord channel webhook URL
DISCORD_WEBHOOK_URL=
# Push notification to your phone via https://ntfy.sh (pick a long random topic name)
NTFY_TOPIC=
